# ==============================================================================
# VAYU-NET Environment Configuration Template
# Digital Public Good for Air Quality & Pollution-Source Intelligence
# Indo-Gangetic Economic Corridor (Punjab-Haryana-Delhi-UP)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="VAYU-NET"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-string-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vayunet_db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/vayunet_db"
# Synchronous DB URL for Alembic migrations & script backfills:
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vayunet_db"

# Redis (Message Broker & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# MinIO / S3 Object Storage (Citizen Photos & Model Checkpoints)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE=false
MINIO_BUCKET_NAME="vayunet-citizen-reports"

# External Data Source Credentials (Real & Free Services)
# NASA FIRMS (Fire Information for Resource Management System) - VIIRS 375m active fire detections
# Request free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=""

# OpenAQ v3 API Key (PM2.5 / PM10 reference monitor telemetry)
# Request free API key at: https://openaq.org
OPENAQ_API_KEY=""

# Google Gemini API (Multimodal Vision for Citizen Reports & Bilingual Advisories)
# Model name MUST come from GEMINI_MODEL, never hardcoded in code
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Alert Dispatch Channels (Optional credentials - UI marks unconfigured channels honestly)
# Telegram Bot Dispatch
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# SMTP Email Dispatch
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="alerts@vayu-net.org"
EMAILS_FROM_NAME="VAYU-NET Air Alert Network"

# Public Data Privacy & Anonymization
REPORT_GEO_ROUNDING_PRECISION=0.005 # ~500 meters grid privacy
REPORT_RETENTION_DAYS=90

# Federated Learning Network
FL_COORDINATOR_URL="http://localhost:8005"
FL_NODE_ID="node-delhi"
